--- /dev/null
+++ b/include/test/fuzz.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/* fuzz/uboot-fit glue: upstream's FUZZ_TEST() list, plus shims for fit_fuzz.c */
+#ifndef __TEST_FUZZ_H
+#define __TEST_FUZZ_H
+#include <linker_lists.h>
+#include <linux/errno.h>
+#include <linux/types.h>
+
+struct fuzz_test {
+	const char *name;
+	int (*func)(const uint8_t *data, size_t size);
+	int flags;
+};
+#define FUZZ_TEST(_name, _flags)					\
+	ll_entry_declare(struct fuzz_test, _name, fuzz_tests) = {	\
+		.name = #_name, .func = _name, .flags = _flags,		\
+	}
+
+/* Include after <image.h>. Here fit_check_format() returns 1 if OK, else 0. */
+#define fit_check_format(fit, size) (fit_check_format(fit) ? 0 : -ENOEXEC)
+#define IH_PHASE_NONE 0
+#define fit_conf_get_prop_node(fit, conf, prop, phase) \
+	fit_conf_get_prop_node(fit, conf, prop)
+#endif
