--- /dev/null
+++ b/test/fuzz/cmd_fuzz.c
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* fuzz/uboot-fit glue: run host files once each through a FUZZ_TEST() */
+#include <common.h>
+#include <command.h>
+#include <image.h>
+#include <os.h>
+#include <test/fuzz.h>
+
+static int do_fuzz(struct cmd_tbl *cmdtp, int flag, int argc,
+		   char *const argv[])
+{
+	struct fuzz_test *t = ll_entry_start(struct fuzz_test, fuzz_tests);
+	struct fuzz_test *end = t + ll_entry_count(struct fuzz_test, fuzz_tests);
+	void *buf;
+	int i, size;
+
+	while (argc >= 3 && t < end && strcmp(t->name, argv[1]))
+		t++;
+	if (argc < 3 || t == end)
+		return CMD_RET_USAGE;
+	for (i = 2; i < argc; i++) {
+		if (os_read_file(argv[i], &buf, &size))
+			return CMD_RET_FAILURE;
+		t->func(buf, size);
+		os_free(buf);
+	}
+	printf("fuzz: %s: ran %d input(s)\n", t->name, argc - 2);
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(fuzz, CONFIG_SYS_MAXARGS, 0, do_fuzz,
+	   "run host files once each through a fuzz test", "<test> <file>...");
