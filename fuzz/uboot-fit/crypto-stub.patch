+#if defined(FUZZ_CRYPTO_STUB) && !defined(USE_HOSTCC)
+/*
+ * FUZZING ONLY (fuzz/uboot-fit/build.sh --crypto-stub). rsa_verify_key() skips
+ * the RSA maths and accepts only if the digest of the signed regions equals
