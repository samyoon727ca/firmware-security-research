+
+static void __attribute__((constructor)) fuzz_crypto_stub_announce(void)
+{
+	os_write(2, fuzz_crypto_stub_banner, sizeof(fuzz_crypto_stub_banner) - 1);
+}
+
+int fuzz_crypto_stub_verify(const uint8_t *hash, int hash_len)
+{
+	char hex[2 * SHA256_SUM_LEN + 1] = "";
+
+	if (hash_len == SHA256_SUM_LEN)
+		*bin2hex(hex, hash, hash_len) = '\0';
+
+	return strcmp(hex, FUZZ_CRYPTO_STUB_XSTR(FUZZ_CRYPTO_STUB_DIGEST)) ? -EACCES : 0;
+}
