# Applied by build.sh on top of sandbox_defconfig, then checked line by line
# against the built .config.

# U-Boot's own fuzz mechanism: libFuzzer + AddressSanitizer (needs clang),
# fed through the sandbox fuzzing-engine device in test.dtb.
CONFIG_FUZZ=y
CONFIG_ASAN=y
CONFIG_DM_FUZZING_ENGINE=y
CONFIG_FUZZING_ENGINE_SANDBOX=y

# The FIT parser as P2's p2.config builds it: signed FIT only, no legacy
# uImages, and the full structural check fit_check_format() runs first.
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_FIT_FULL_CHECK=y
# CONFIG_LEGACY_IMAGE_FORMAT is not set

# No SDL display, so the build needs no libsdl2.
# CONFIG_SANDBOX_SDL is not set
# CONFIG_VIDEO_SANDBOX_SDL is not set

# EFI capsule authentication is unrelated to FIT and needs efitools on the host.
# CONFIG_EFI_CAPSULE_AUTHENTICATE is not set
