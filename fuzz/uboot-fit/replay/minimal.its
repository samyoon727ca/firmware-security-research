/dts-v1/;

/*
 * Replay seed: the smallest FIT that passes fit_check_format() with
 * FIT_SIGNATURE (no unit addresses), with one hashed image and a default
 * configuration so the fuzzer starts from the structure a boot loader reads.
 * ci-replay.sh compiles it with the tree's own mkimage; the .itb is not
 * committed.
 */

/ {
	description = "uboot-fit replay seed";
	#address-cells = <1>;

	images {
		kernel-1 {
			description = "placeholder payload";
			data = "uboot-fit seed payload";
			type = "kernel";
			arch = "sandbox";
			os = "linux";
			compression = "none";
			load = <0x1000000>;
			entry = <0x1000000>;
			hash-1 {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "seed configuration";
			kernel = "kernel-1";
		};
	};
};
